# Public origin used for metadata, robots.txt, and sitemap.xml.
# Use the deployed HTTPS origin in production. Local development safely falls
# back to http://localhost:3000 when this variable is not set.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional public contact address. When omitted, the contact page displays an
# honest launch placeholder instead of inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Server-only Resend configuration. Do not prefix these variables with
# NEXT_PUBLIC_ and do not commit real values.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Production distributed rate limiting through Upstash Redis REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_HASH_SECRET=""

# Optional comma-separated browser origins in addition to NEXT_PUBLIC_SITE_URL.
# Keep this empty unless a preview or alternate origin must submit enquiries.
CONTACT_ALLOWED_ORIGINS=""
