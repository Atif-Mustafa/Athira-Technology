# Public origin used for metadata, canonical/OG URLs, robots.txt, and
# sitemap.xml.
#
# Local: optional. Falls back to http://localhost:3000 when unset.
# Preview: leave unset. Vercel's automatic VERCEL_PROJECT_PRODUCTION_URL /
#   VERCEL_URL system variables resolve the origin for every new Preview
#   deployment; you do not need to update this per deployment. Preview
#   canonical/SEO URLs intentionally point at the stable production origin
#   (Preview already responds noindex).
# Production: set this to the stable production/custom domain, e.g.
#   NEXT_PUBLIC_SITE_URL="https://example.com". Falls back to Vercel's
#   VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=""

# Optional public contact address. When omitted, the contact page displays an
# honest launch placeholder instead of inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Server-only Resend configuration. Do not prefix these variables with
# NEXT_PUBLIC_ and do not commit real values.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Production distributed rate limiting through Upstash Redis REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_HASH_SECRET=""

# Optional override: comma-separated additional trusted browser origins for
# the contact route (e.g. a second Preview alias, a staging domain). Not
# required for normal Vercel deployments — same-origin Preview/Production
# requests are already accepted automatically from the request itself and
# from Vercel's VERCEL_BRANCH_URL / VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL
# system variables. Keep this empty unless a genuinely separate origin needs
# to submit enquiries.
CONTACT_ALLOWED_ORIGINS=""

# Public Supabase Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only Supabase Auth admin credential.
# SERVER ONLY. SECRET. NEVER NEXT_PUBLIC_. Configure manually in Vercel Preview/Production.
SUPABASE_SECRET_KEY=""
