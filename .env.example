# Public origin used for metadata, robots.txt, and sitemap.xml.
# Use the deployed HTTPS origin in production. Local development safely falls
# back to http://localhost:3000 when this variable is not set.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional public contact address. When omitted, the contact page displays an
# honest launch placeholder instead of inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=""
